{
  "name": "lean4-lsp-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for Lean 4 theorem proving, zero-latency .ilean navigation, and C FFI cross-language inspection",
  "main": "dist/index.js",
  "type": "module",
  "types": "dist/index.d.ts",
  "bin": {
    "lean-lsp-mcp": "./bin/lean-lsp-mcp.js",
    "lean4-lsp-mcp": "./bin/lean-lsp-mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --experimental-strip-types tests/test_lean_lsp_mcp.mjs && node --experimental-strip-types tests/test_file_worker_manager.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/r-irbe/lean4-lsp-mcp.git"
  },
  "keywords": [
    "lean4",
    "mathlib4",
    "mcp",
    "model-context-protocol",
    "lsp",
    "theorem-proving",
    "clangd",
    "ffi"
  ],
  "author": "r-irbe",
  "license": "Apache-2.0",
  "capabilities": {
    "tools": [
      {
        "name": "lean_goal",
        "description": "Interactive proof state and goal inspection",
        "access": "read",
        "scope": "workspace",
        "network": false
      },
      {
        "name": "lean_search",
        "description": "Unified declaration, semantic, ontology, reservoir, and Kuzu knowledge graph search",
        "access": "read",
        "scope": "workspace_and_public_apis",
        "network": true,
        "allowedDomains": [
          "loogle.lean-lang.org",
          "leansearch.net",
          "export.arxiv.org",
          "huggingface.co",
          "raw.githubusercontent.com"
        ]
      },
      {
        "name": "lean_blueprint",
        "description": "Blueprint generation, status audit, and knowledge graph neighborhood",
        "access": "read_write",
        "scope": "workspace",
        "network": false
      },
      {
        "name": "lean_metrics",
        "description": "Module census, dependency hierarchy, and DAG graphs",
        "access": "read",
        "scope": "workspace",
        "network": false
      },
      {
        "name": "lean_ffi",
        "description": "C FFI symbol resolution and Lean sysroot inspection",
        "access": "read",
        "scope": "workspace_and_sysroot",
        "network": false
      },
      {
        "name": "lean_exec",
        "description": "Ephemeral Lean 4 execution via lean --stdin",
        "access": "exec",
        "scope": "isolated_process",
        "network": false
      }
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
